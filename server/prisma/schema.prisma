// Author: Preston Lee

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentEntityType {
  User
  Group
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ssoIssuer   String    @map("sso_issuer")
  ssoSubject  String    @map("sso_subject")
  email       String?
  displayName String?   @map("display_name")
  isSuspended Boolean   @default(false) @map("is_suspended")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions          Session[]
  memberships       Member[]
  apiTokens         ApiToken[]
  sandboxesCreated  Sandbox[]             @relation("SandboxCreator")
  collaborations    SandboxCollaborator[]
  launchScenarios   LaunchScenario[]      @relation("ScenarioCreator")
  personas          UserPersona[]         @relation("PersonaCreator")
  applicationsCreated Application[]       @relation("ApplicationCreator")
  jobsCreated       Job[]                 @relation("JobCreator")
  githubConnection GitHubConnection?
  hostedApplications HostedApplication[] @relation("HostedOwner")
  hostedCollaborations HostedCollaborator[]
  hostedQuota HostedOwnerQuota?
  jobSchedules JobSchedule[]



  @@unique([ssoIssuer, ssoSubject])
  @@index([email])
  @@index([isSuspended])
  @@map("users")
}

model Session {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at")
  idleExpiresAt        DateTime  @map("idle_expires_at")
  encryptedTokenBundle String?   @map("encrypted_token_bundle")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  ssoRoles             Json      @default("[]") @map("sso_roles")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([idleExpiresAt])
  @@map("sessions")
}

model ApiToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @map("token_hash")
  prefix     String
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("api_tokens")
}

model Group {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique
  description    String?
  ssoRoleMapping String?  @map("sso_role_mapping")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  members Member[]

  @@map("groups")
}

model Role {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String   @unique
  description                String?
  default                    Boolean  @default(false)
  ssoRoleMapping             String?  @map("sso_role_mapping")
  
  permission_sandboxes_create Boolean  @default(true) @map("permission_sandboxes_create")
  permission_sandboxes_shared Boolean  @default(false) @map("permission_sandboxes_shared")
  permission_ehr_simulator   Boolean  @default(true) @map("permission_ehr_simulator")
  permission_data_manager    Boolean  @default(true) @map("permission_data_manager")
  permission_applications_register Boolean  @default(true) @map("permission_applications_register")
  permission_applications_deployment Boolean @default(false) @map("permission_applications_deployment")
  permission_package_import  Boolean  @default(true) @map("permission_package_import")
  permission_knowledge_publish Boolean @default(false) @map("permission_knowledge_publish")
  permission_global_manage   Boolean  @default(false) @map("permission_global_manage")
  permissions                Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([default])
  @@map("roles")
}

model Member {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("members")
}

model Appointment {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType AppointmentEntityType @map("entity_type")
  entityId   String                @map("entity_id") @db.Uuid
  roleId     String                @map("role_id") @db.Uuid
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, roleId])
  @@index([entityId])
  @@index([roleId])
  @@map("appointments")
}

model Sandbox {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId       String   @unique @map("sandbox_id")
  name            String
  description     String?
  fhirVersion     String   @default("R4") @map("fhir_version")
  partitionId     Int      @map("partition_id")
  allowOpenAccess Boolean  @default(false) @map("allow_open_access")
  visibility      String   @default("PRIVATE")
  isShared        Boolean  @default(false) @map("is_shared")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  lastAccessedAt  DateTime? @map("last_accessed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdByUser   User                  @relation("SandboxCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  collaborators   SandboxCollaborator[]
  launchScenarios LaunchScenario[]
  personas        UserPersona[]
  cdsEndpoints    CdsServiceEndpoint[]
  bulkExports     BulkExportJob[]
  jobs            Job[]
  applications    Application[]
  hostedApplications HostedSandbox[]


  @@index([createdByUserId])
  @@index([fhirVersion])
  @@index([partitionId])
  @@index([lastAccessedAt])
  @@index([createdAt])
  @@map("sandboxes")
}

model SandboxCollaborator {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId String   @map("sandbox_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("READ_WRITE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sandboxId, userId])
  @@index([userId])
  @@map("sandbox_collaborators")
}

model Application {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId               String?  @map("sandbox_id") @db.Uuid
  clientId                String   @unique @map("client_id")
  clientSecret            String?  @map("client_secret")
  clientName              String   @map("client_name")
  clientUri               String?  @map("client_uri")
  logoUri                 String?  @map("logo_uri")
  launchUri               String   @map("launch_uri")
  redirectUris            Json     @default("[]") @map("redirect_uris")
  scope                   String   @default("openid profile email patient/*.rs user/*.cruds launch launch/patient")
  isCustom                Boolean  @default(true) @map("is_custom")
  isSample                Boolean  @default(false) @map("is_sample")
  briefDescription        String?  @map("brief_description")
  author                  String?
  samplePatients          String?  @map("sample_patients")
  manifestUrl             String?  @map("manifest_url")
  tokenEndpointAuthMethod String   @default("client_secret_basic") @map("token_endpoint_auth_method")
  jwksUri                 String?  @map("jwks_uri")
  jwks                    Json?
  pkceRequired            Boolean  @default(false) @map("pkce_required")
  createdByUserId         String?  @map("created_by_user_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  hostedApplicationId     String? @map("hosted_application_id") @db.Uuid
  hostedChannel           String? @map("hosted_channel")
  hostedApplication       HostedApplication? @relation(fields: [hostedApplicationId], references: [id], onDelete: Cascade)

  sandbox         Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  createdByUser   User?            @relation("ApplicationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  launchScenarios LaunchScenario[]

  @@index([sandboxId])
  @@map("applications")
}

model GitHubConnection {
  userId String @id @map("user_id") @db.Uuid
  githubUserId String @unique @map("github_user_id")
  login String
  encryptedTokens String @map("encrypted_tokens")
  expiresAt DateTime @map("expires_at")
  refreshExpiresAt DateTime @map("refresh_expires_at")
  status String @default("CONNECTED")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("github_connections")
}

model HostedApplication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  description String @default("")
  ownerUserId String @map("owner_user_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid
  repositoryId String @map("repository_id")
  repository String
  installationId String @map("installation_id")
  branch String @default("main")
  projectDirectory String @default("") @map("project_directory")
  buildCommand String @default("npm ci && npm run build") @map("build_command")
  outputDirectory String @default("dist") @map("output_directory")
  nodeVersion String @default("26") @map("node_version")
  launchPath String @default("index.html") @map("launch_path")
  callbackPath String @default("index.html") @map("callback_path")
  scope String @default("launch launch/patient openid fhirUser patient/*.rs")
  autoPublish Boolean @default(false) @map("auto_publish")
  publishingPaused Boolean @default(false) @map("publishing_paused")
  suspended Boolean @default(false)
  deletedAt DateTime? @map("deleted_at")
  generation Int @default(0)
  policyUpdatedAt DateTime @default(now()) @map("policy_updated_at")
  lastDeveloperActivityAt DateTime @default(now()) @map("last_developer_activity_at")
  lastServedAt DateTime? @map("last_served_at")
  lastLaunchAt DateTime? @map("last_launch_at")
  lastReconciledAt DateTime? @map("last_reconciled_at")
  reconciliationError String? @map("reconciliation_error")
  suspendedAt DateTime? @map("suspended_at")
  deleteAfter DateTime? @map("delete_after")
  cleanupProtected Boolean @default(false) @map("cleanup_protected")
  previewBuildId String? @map("preview_build_id") @db.Uuid
  publishedBuildId String? @map("published_build_id") @db.Uuid
  desiredBuildId String? @map("desired_build_id") @db.Uuid
  isTemplate Boolean @default(false) @map("is_template")
  templateVisibility String @default("PRIVATE") @map("template_visibility")
  templateCommit String? @map("template_commit")
  originatingCommit String? @map("originating_commit")
  transferToUserId String? @map("transfer_to_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation("HostedOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  collaborators HostedCollaborator[]
  builds HostedBuild[]
  registrations Application[]
  sandboxes HostedSandbox[]
  @@index([ownerUserId])
  @@index([repositoryId])
  @@index([deletedAt, deleteAfter])
  @@index([lastReconciledAt])
  @@map("hosted_applications")
}

model HostedCollaborator {
  applicationId String @map("application_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role String
  application HostedApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([applicationId, userId])
  @@map("hosted_collaborators")
}

model HostedBuild {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  requestedByUserId String? @map("requested_by_user_id") @db.Uuid
  githubActor String? @map("github_actor")
  branch String
  commit String
  generation Int
  runId String? @map("run_id")
  requestEvent String? @map("request_event")
  runAttempt Int @default(1) @map("run_attempt")
  artifactId String? @map("artifact_id")
  launchPath String @default("index.html") @map("launch_path")
  callbackPath String @default("index.html") @map("callback_path")
  scope String @default("launch launch/patient openid fhirUser patient/*.rs")
  status String @default("WAITING")
  error String?
  githubUrl String? @map("github_url")
  directory String?
  byteSize BigInt @default(0) @map("byte_size")
  jobId String? @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  application HostedApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, runId, runAttempt])
  @@index([applicationId, createdAt])
  @@map("hosted_builds")
}

model HostedSandbox {
  applicationId String @map("application_id") @db.Uuid
  sandboxId String @map("sandbox_id") @db.Uuid
  application HostedApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  @@id([applicationId, sandboxId])
  @@map("hosted_sandboxes")
}

model HostedAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String? @map("application_id") @db.Uuid
  userId String? @map("user_id") @db.Uuid
  action String
  detail Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("hosted_audit")
}

model LaunchScenario {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId         String    @map("sandbox_id") @db.Uuid
  title             String
  description       String?
  applicationId     String?   @map("application_id") @db.Uuid
  userPersonaId     String?   @map("user_persona_id") @db.Uuid
  patientFhirId     String?   @map("patient_fhir_id")
  patientName       String?   @map("patient_name")
  encounterFhirId   String?   @map("encounter_fhir_id")
  locationFhirId    String?   @map("location_fhir_id")
  intent            String?
  smartStyleUrl     String?   @map("smart_style_url")
  needPatientBanner Boolean   @default(true) @map("need_patient_banner")
  fhirContext       Json      @default("[]") @map("fhir_context")
  contextParams     Json      @default("{}") @map("context_params")
  lastLaunchAt      DateTime? @map("last_launch_at")
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sandbox       Sandbox      @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  userPersona   UserPersona? @relation(fields: [userPersonaId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("ScenarioCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([sandboxId])
  @@map("launch_scenarios")
}

model UserPersona {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId        String   @map("sandbox_id") @db.Uuid
  personaUserId    String   @map("persona_user_id")
  personaName      String   @map("persona_name")
  fhirResourceType String   @default("Practitioner") @map("fhir_resource_type")
  fhirResourceId   String   @map("fhir_resource_id")
  fhirResourceName String   @map("fhir_resource_name")
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sandbox         Sandbox          @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  createdByUser   User?            @relation("PersonaCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  launchScenarios LaunchScenario[]

  @@unique([sandboxId, personaUserId])
  @@index([sandboxId])
  @@map("user_personas")
}

model CdsServiceEndpoint {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId    String   @map("sandbox_id") @db.Uuid
  name         String
  url          String
  servicesJson Json     @default("[]") @map("services_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
  @@map("cds_service_endpoints")
}

model SmartAuthSession {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId             String    @map("sandbox_id")
  clientId              String    @map("client_id")
  code                  String?   @unique
  codeChallenge         String?   @map("code_challenge")
  codeChallengeMethod   String?   @map("code_challenge_method")
  redirectUri           String    @map("redirect_uri")
  scope                 String
  launchId              String?   @map("launch_id")
  patientFhirId         String?   @map("patient_fhir_id")
  encounterFhirId       String?   @map("encounter_fhir_id")
  userPersonaId         String?   @map("user_persona_id")
  fhirVersion           String    @default("R4") @map("fhir_version")
  fhirUser              String?   @map("fhir_user")
  fhirContext           Json?     @map("fhir_context")
  accessToken           String?   @unique @map("access_token")
  refreshToken          String?   @unique @map("refresh_token")
  tokenType             String    @default("Bearer") @map("token_type")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  codeExpiresAt         DateTime? @map("code_expires_at")
  isRevoked             Boolean   @default(false) @map("is_revoked")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([launchId])
  @@index([accessToken])
  @@index([refreshToken])
  @@map("smart_auth_sessions")
}

model SmartClientAssertion {
  id String @id
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("smart_client_assertions")
}

model BulkExportJob {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sandboxId       String   @map("sandbox_id") @db.Uuid
  exportType      String   @default("system") @map("export_type")
  status          String   @default("queued")
  requestUrl      String   @map("request_url")
  outputFiles     Json     @default("[]") @map("output_files")
  error           String?
  transactionTime DateTime @default(now()) @map("transaction_time")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
  @@index([status])
  @@map("bulk_export_jobs")
}

model Job {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  jobType         String    @map("job_type")
  status          String    @default("queued")
  progress        Int       @default(0)
  stage           String?
  input           Json      @default("{}")
  output          Json      @default("{}")
  error           String?
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  lockedBy        String?   @map("locked_by")
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  sandboxId       String?   @map("sandbox_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  scheduleId String? @map("schedule_id") @db.Uuid
  scheduledOccurrence String? @unique @map("scheduled_occurrence")
  schedule JobSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  sandbox       Sandbox? @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([jobType])
  @@index([scheduleId, status])
  @@index([sandboxId])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("jobs")
}

model ImplementationGuide {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId              String   @map("package_id")
  version                String
  title                  String
  description            String?
  fhirVersion            String   @default("4.0.1") @map("fhir_version")
  category               String   @default("General")
  canonicalUrl           String?  @map("canonical_url")
  url                    String?
  isSuggested            Boolean  @default(true) @map("is_suggested")
  author                 String?
  dependencies           Json     @default("{}")
  tarballUrl             String?  @map("tarball_url")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([packageId, version])
  @@index([packageId])
  @@index([category])
  @@index([fhirVersion])
  @@index([isSuggested])
  @@map("implementation_guides")
}



// Deliberately independent of application FKs: historical traffic survives app purge.
model HostedUsageHour {
  applicationId String @map("application_id") @db.Uuid
  channel String
  hour DateTime @db.Timestamptz(3)
  requests Int @default(0)
  documents Int @default(0)
  bots Int @default(0)
  status2xx Int @default(0) @map("status_2xx")
  status3xx Int @default(0) @map("status_3xx")
  status4xx Int @default(0) @map("status_4xx")
  status5xx Int @default(0) @map("status_5xx")
  rateLimited Int @default(0) @map("rate_limited")
  aborted Int @default(0)
  bytes BigInt @default(0)
  durationMs Float @default(0) @map("duration_ms")
  histogram Json @default("[]")
  visitors Bytes
  launches Int @default(0)
  @@id([applicationId, channel, hour])
  @@index([hour])
  @@map("hosted_usage_hours")
}

model HostedUsageCollector {
  id String @id @db.Uuid
  kind String
  sequence Int @default(0)
  dropped Int @default(0)
  startedAt DateTime @default(now()) @map("started_at")
  lastFlushedAt DateTime @default(now()) @map("last_flushed_at")
  @@index([kind, lastFlushedAt])
  @@map("hosted_usage_collectors")
}

model HostedOwnerQuota {
  userId String @id @map("user_id") @db.Uuid
  applicationLimit Int? @map("application_limit")
  storageBytesLimit BigInt? @map("storage_bytes_limit")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("hosted_owner_quotas")
}

enum JobScheduleFrequency {
  EVERY_MINUTE
  HOURLY
  DAILY
}

model JobSchedule {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemKey String? @unique @map("system_key")
  name String
  description String @default("")
  jobType String @map("job_type")
  input Json @default("{}")
  frequency JobScheduleFrequency
  minuteOfHour Int @default(0) @map("minute_of_hour")
  hourOfDay Int @default(0) @map("hour_of_day")
  enabled Boolean @default(true)
  nextRunAt DateTime @map("next_run_at") @db.Timestamptz(3)
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdByUser User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  jobs Job[]
  @@index([enabled, nextRunAt])
  @@map("job_schedules")
}

// An explicit history purge is a durable cutoff, including for delayed collector retries.
model HostedUsagePolicy {
  id String @id
  purgedBefore DateTime @map("purged_before") @db.Timestamptz(3)
  @@map("hosted_usage_policy")
}
