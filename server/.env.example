# Local development defaults for docker-compose.development.yml
# Copy to server/.env:  cp server/.env.example server/.env

# Prisma / Postgres (host port 5433 → container 5432)
FHIR_STUDIO_SERVER_DATABASE_URL=postgresql://postgres:password@localhost:5433/fhir_studio_development
DATABASE_URL=postgresql://postgres:password@localhost:5433/fhir_studio_development

# SSO (OIDC BFF) — Authentik on http://localhost:9000 (blueprint: docker/authentik/blueprints/fhir-studio-oidc.yaml)
FHIR_STUDIO_SERVER_SSO_ISSUER_URL=http://localhost:9000/application/o/fhir-studio/
FHIR_STUDIO_SERVER_SSO_CLIENT_ID=fhir-studio-development
FHIR_STUDIO_SERVER_SSO_CLIENT_SECRET=fhir-studio-development-secret
FHIR_STUDIO_SERVER_SSO_REDIRECT_URL=http://localhost:3000/sso/callback
FHIR_STUDIO_SERVER_SSO_SCOPES=openid profile email offline_access
FHIR_STUDIO_SERVER_SSO_POST_LOGOUT_REDIRECT_URL=http://localhost:4200
FHIR_STUDIO_SERVER_UI_BASE_URL=http://localhost:4200
FHIR_STUDIO_SERVER_CORS_ORIGINS=http://localhost:4200
FHIR_STUDIO_SERVER_SESSION_SECRET=fhir-studio-development-session-secret-32b
FHIR_STUDIO_SERVER_API_TOKEN_PEPPER=fhir-studio-development-api-token-pepper-32b
FHIR_STUDIO_SERVER_BOOTSTRAP_ADMIN_EMAILS=administrator@localhost,admin@example.com

# Stock HAPI FHIR JPA Endpoints (Partitioned) — host ports 8083/8084/8085
# When ENABLED=false, the matching BASE_URL is not required and is ignored if set.
FHIR_STUDIO_HAPI_R4_ENABLED=true
FHIR_STUDIO_HAPI_R4_BASE_URL=http://localhost:8083/fhir
FHIR_STUDIO_HAPI_R4B_ENABLED=true
FHIR_STUDIO_HAPI_R4B_BASE_URL=http://localhost:8084/fhir
FHIR_STUDIO_HAPI_R5_ENABLED=true
FHIR_STUDIO_HAPI_R5_BASE_URL=http://localhost:8085/fhir

# Base local development works without a GitHub App or hosting proxy.
# Set true and complete every hosting setting to enable application hosting.
FHIR_STUDIO_HOSTING_ENABLED=false
# See doc/application-hosting.md for operator configuration.
# Roles default to permission_applications_deployment=false (global_manage bypasses).
# Required for production hosting: independent RSA PKCS8 PEM, with literal \n for line breaks.
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
FHIR_STUDIO_SERVER_SMART_SIGNING_KEY=
# Required when hosting is enabled; ROOT must be an existing absolute path.
FHIR_STUDIO_HOSTING_DOMAIN=
FHIR_STUDIO_HOSTING_ROOT=
FHIR_STUDIO_HOSTING_STUDIO_ORIGIN=
FHIR_STUDIO_HOSTING_ENCRYPTION_KEY=
FHIR_STUDIO_HOSTING_GITHUB_APP_ID=
FHIR_STUDIO_HOSTING_GITHUB_CLIENT_ID=
FHIR_STUDIO_HOSTING_GITHUB_CLIENT_SECRET=
# PEM with literal \n separators is supported.
FHIR_STUDIO_HOSTING_GITHUB_PRIVATE_KEY=
FHIR_STUDIO_HOSTING_GITHUB_WEBHOOK_SECRET=
FHIR_STUDIO_HOSTING_GITHUB_SLUG=
FHIR_STUDIO_HOSTING_MAX_ARCHIVE_BYTES=20971520
FHIR_STUDIO_HOSTING_MAX_EXPANDED_BYTES=52428800
FHIR_STUDIO_HOSTING_MAX_FILES=1000
FHIR_STUDIO_HOSTING_MAX_APPS_PER_USER=10
FHIR_STUDIO_HOSTING_MAX_STORAGE_BYTES=10737418240
# Static host only. The trusted proxy must replace client forwarding headers.
FHIR_STUDIO_HOSTING_TRUST_PROXY_HOPS=0

# Independent analytics cookie signing key: openssl rand -base64 32
FHIR_STUDIO_HOSTING_ANALYTICS_KEY=
