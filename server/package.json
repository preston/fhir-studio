{
  "name": "@fhir-studio/server",
  "version": "0.0.0",
  "type": "module",
  "description": "FHIR Studio Express Backend & SMART on FHIR Gateway",
  "bin": {
    "fhir-studio": "./build/bin/fhir-studio.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "npm run build && node build/server.js",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "test:hosting": "node --import tsx --test test/hosting.test.ts test/hosting-administration.test.ts",
    "test:hosting:integration": "node --import tsx --test test/hosting.integration.test.ts test/hosting-administration.integration.test.ts",
    "host": "node --env-file-if-exists=.env build/hosted/host.js",
    "dev": "tsx watch src/server.ts",
    "watch": "tsx watch src/server.ts",
    "worker": "node --env-file-if-exists=.env build/worker.js",
    "worker:watch": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx src/db/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fhir-studio/core": "file:../core",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
