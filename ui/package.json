{
  "name": "@fhir-studio/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "if [ -f .env ]; then set -a && . ./.env && set +a; fi && envsubst < public/configuration.template.js > public/configuration.js && ng serve",
    "build": "ng build",
    "typecheck": "tsc --noEmit",
    "watch": "if [ -f .env ]; then set -a && . ./.env && set +a; fi && envsubst < public/configuration.template.js > public/configuration.js && ng build --watch --configuration development",
    "test": "ng test",
    "test:hosting": "node --test test/hosted-editor.test.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@fhir-studio/core": "file:../core",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "bootswatch": "^5.3.8",
    "codemirror": "^6.0.2",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/node": "^26.6.5",
    "typescript": "<7"
  }
}
