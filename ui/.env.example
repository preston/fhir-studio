# FHIR Studio UI Environment Variables (Development Defaults)
# Copied into public/configuration.js via envsubst on `npm start` / container entrypoint.

# Public origin of the FHIR Studio API (no trailing slash). Used in Personal access tokens
# curl examples — typically cannot be inferred from the UI origin when UI and API are split.
FHIR_STUDIO_SERVER_PUBLIC_API_BASE_URL=http://localhost:3000
